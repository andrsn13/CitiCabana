{
  "projectType": "webapp",
  "assertions": [
    {
      "name": "production-build",
      "kind": "process",
      "command": "npm",
      "args": ["run", "build"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "npm",
      "args": ["test", "--", "--test-reporter=tap"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "public-home-serves",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "dev"],
      "url": "http://127.0.0.1:3000/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    },
    {
      "name": "bookings-page-serves",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "dev"],
      "url": "http://127.0.0.1:3000/admin/bookings.html",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    },
    {
      "name": "room-status-page-serves",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "dev"],
      "url": "http://127.0.0.1:3000/admin/room-status.html",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    }
  ]
}
