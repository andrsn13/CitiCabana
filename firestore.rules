rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // [PHASE 1 SECURITY] RBAC Helper Function
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    // [PHASE 1 SECURITY] Admin Users Collection
    match /admin_users/{userId} {
      // Users can read their own admin doc to verify their role
      allow read: if request.auth != null && request.auth.uid == userId;
      // Nobody can write from the client - must be created via Firebase Console
      allow write: if false; 
    }

    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /roomStatus/{roomId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // [PHASE 2 CMS] Content Collections
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
